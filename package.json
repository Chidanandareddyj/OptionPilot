{
  "name": "optionpilot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @optionpilot/web",
    "build": "npm run build -w @optionpilot/web",
    "start": "npm run start -w @optionpilot/web",
    "lint": "npm run lint -w @optionpilot/web && npm run lint -w @optionpilot/shared",
    "test": "npm test -w @optionpilot/shared && node --experimental-strip-types --test relay/universe.test.mjs"
  }
}
